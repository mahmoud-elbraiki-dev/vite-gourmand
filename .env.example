# --- Application ---
APP_ENV=dev                 # dev | prod
APP_URL=http://localhost:8000

# --- Base relationnelle (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite_gourmand_ecf
DB_USER=root
DB_PASS=

# --- Base NoSQL (MongoDB) ---
# Laisser vide en local si MongoDB n'est pas installé : l'application bascule
# alors sur un stockage documentaire JSON (storage/nosql) avec la même interface.
MONGO_URI=
MONGO_DB=vite_gourmand

# --- E-mails (SMTP) ---
# Sans SMTP configuré, les e-mails sont écrits dans storage/logs/mail.log (mode dev).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=contact@vitegourmand.fr
MAIL_FROM_NAME="Vite & Gourmand"
MAIL_COMPANY=contact@vitegourmand.fr
